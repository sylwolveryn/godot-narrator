{
	"_comment": "Origin beats (source of truth for the text: docs/narration_origin.md, approved 2026-11-02, task-044). Same schema as m1_beats.json plus event_param. Appended after the M1 table by tools/build_narration.gd; the lint settings live in m1_beats.json.",
	"beats": [
		{"id": "claim_demonic_name", "text": "Once the static reads your name, it never lets go.", "trigger": "EVENT", "event": "CORRUPTION_ENTERED", "event_param": "", "min_run": 4, "max_run": -1, "min_deaths": 3, "once": true, "mood": "low_drone", "supports": ["demonic"], "contradicts": [], "role": "CLAIM", "layer": "NARRATOR"},
		{"id": "claim_ai_one", "text": "Built things never choose to be one. Not for long.", "trigger": "EVENT", "event": "TRANSFORMED", "event_param": "", "min_run": 4, "max_run": -1, "min_deaths": 3, "once": true, "mood": "static", "supports": ["ai"], "contradicts": [], "role": "CLAIM", "layer": "NARRATOR"},
		{"id": "claim_angelic_dark", "text": "Fallen from the light, you could never rest in the dark.", "trigger": "EVENT", "event": "IDLE_FOR_SHORT", "event_param": "", "min_run": 4, "max_run": -1, "min_deaths": 3, "once": true, "mood": "chime", "supports": ["angelic"], "contradicts": [], "role": "CLAIM", "layer": "NARRATOR"},
		{"id": "claim_alien_weight", "text": "If you came from the stars, nothing here would move for you.", "trigger": "EVENT", "event": "ITEM_REVEALED", "event_param": "", "min_run": 4, "max_run": -1, "min_deaths": 3, "once": true, "mood": "pulse", "supports": ["alien"], "contradicts": [], "role": "CLAIM", "layer": "NARRATOR"},
		{"id": "broken_demonic", "text": "...It let you go. Then that was not your name.", "trigger": "EVENT", "event": "ORIGIN_STRUCK", "event_param": "demonic", "min_run": 4, "max_run": -1, "min_deaths": 3, "once": false, "mood": "low_drone", "supports": [], "contradicts": ["demonic"], "role": "BROKEN", "layer": "NARRATOR"},
		{"id": "broken_ai", "text": "...Still one. Then not built. Or built to lie.", "trigger": "EVENT", "event": "ORIGIN_STRUCK", "event_param": "ai", "min_run": 4, "max_run": -1, "min_deaths": 3, "once": false, "mood": "static", "supports": [], "contradicts": ["ai"], "role": "BROKEN", "layer": "NARRATOR"},
		{"id": "broken_angelic", "text": "...You rested there. Then not the light. Not yet.", "trigger": "EVENT", "event": "ORIGIN_STRUCK", "event_param": "angelic", "min_run": 4, "max_run": -1, "min_deaths": 3, "once": false, "mood": "chime", "supports": [], "contradicts": ["angelic"], "role": "BROKEN", "layer": "NARRATOR"},
		{"id": "broken_alien", "text": "...It moved for you. Then not the stars.", "trigger": "EVENT", "event": "ORIGIN_STRUCK", "event_param": "alien", "min_run": 4, "max_run": -1, "min_deaths": 3, "once": false, "mood": "pulse", "supports": [], "contradicts": ["alien"], "role": "BROKEN", "layer": "NARRATOR"},
		{"id": "recant_demonic", "text": "I was too sure. Some names hide longer in the static.", "trigger": "EVENT", "event": "ORIGIN_RECANTED", "event_param": "demonic", "min_run": 4, "max_run": -1, "min_deaths": 3, "once": false, "mood": "low_drone", "supports": ["demonic"], "contradicts": [], "role": "RECANT", "layer": "NARRATOR"},
		{"id": "recant_ai", "text": "I was too sure. Machines can wait. Longer than that.", "trigger": "EVENT", "event": "ORIGIN_RECANTED", "event_param": "ai", "min_run": 4, "max_run": -1, "min_deaths": 3, "once": false, "mood": "static", "supports": ["ai"], "contradicts": [], "role": "RECANT", "layer": "NARRATOR"},
		{"id": "recant_angelic", "text": "I spoke too soon. Light can rest. Just never for long.", "trigger": "EVENT", "event": "ORIGIN_RECANTED", "event_param": "angelic", "min_run": 4, "max_run": -1, "min_deaths": 3, "once": false, "mood": "chime", "supports": ["angelic"], "contradicts": [], "role": "RECANT", "layer": "NARRATOR"},
		{"id": "recant_alien", "text": "No. I was too sure. The stars come back.", "trigger": "EVENT", "event": "ORIGIN_RECANTED", "event_param": "alien", "min_run": 4, "max_run": -1, "min_deaths": 3, "once": false, "mood": "pulse", "supports": ["alien"], "contradicts": [], "role": "RECANT", "layer": "NARRATOR"},
		{"id": "item_carried_down", "text": "Not across stars. I watched something carry you down.", "trigger": "EVENT", "event": "ITEM_REVEALED", "event_param": "", "min_run": 6, "max_run": -1, "min_deaths": 5, "once": true, "mood": "chime", "supports": ["angelic"], "contradicts": ["alien"], "role": "STORY", "layer": "NARRATOR"},
		{"id": "time_hull_burn", "text": "There was no heaven. I saw the hull burn.", "trigger": "TIME", "delay": 90.0, "event_param": "", "min_run": 5, "max_run": -1, "min_deaths": 4, "once": true, "mood": "pulse", "supports": ["alien"], "contradicts": ["angelic"], "role": "STORY", "layer": "NARRATOR"}
	]
}
